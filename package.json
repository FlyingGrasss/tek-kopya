{
  "name": "tek-kopya",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "predev": "tsx server/seed.ts --if-empty",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"next dev -p 3000\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "tsx watch server/index.ts",
    "seed": "tsx server/seed.ts",
    "seed:reset": "tsx server/seed.ts --reset",
    "smoke": "tsx server/smoke.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "next lint",
    "build": "next build",
    "start": "next start -p 3000"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
